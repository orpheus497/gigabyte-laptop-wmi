[Unit]
Description=Notify on Gigabyte laptop fan preset changes
# The attribute only exists while the driver is loaded. Without this the
# service would start, fail to open it, and be restarted forever.
ConditionPathExists=/sys/devices/platform/gigabyte_laptop/fan_preset
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gigabyte-fan-preset-notify
# Exits non-zero when the driver is unloaded, so come back if it returns.
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
