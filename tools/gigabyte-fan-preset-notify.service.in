[Unit]
Description=Notify on Gigabyte laptop fan preset changes
# Started by the matching .path unit when the driver's attribute appears, so
# there is deliberately no ConditionPathExists here: that condition was what
# stopped the service ever coming back after a module reload, because a skipped
# start leaves nothing watching for the driver's return.

[Service]
Type=simple
ExecStart=@BINDIR@/gigabyte-fan-preset-notify
# No Restart=, and none is needed. The program recovers from a driver reload by
# re-opening the attribute itself, because no unit dependency can do it for it:
# both PathExists= and a udev SYSTEMD_USER_WANTS= enqueue a start, and a start
# against a still-active unit is a no-op. It exits non-zero only for a failure
# at startup or a broken poll(), neither of which a restart loop would help.

# A watcher that should sit at zero CPU has no business using a measurable
# amount, so cap it. This is a backstop against a bug, not tuning: an earlier
# version of this program mishandled the POLLERR that kernfs returns without
# blocking once the attribute is removed, and pegged a core until it was
# stopped by hand. Capped, the same bug costs 5% of one core and shows up in
# `systemctl --user status` as CPU time on a process that should have none.
#
# CPUQuota alone, with no CPUAccounting=: systemd 259 removed that option and
# logs "Support for option CPUAccounting= has been removed and it is ignored"
# on every daemon-reload. Accounting still happens, because cgroup v2 reports
# cpu.stat unconditionally, so CPUUsageNSec remains readable.
CPUQuota=5%

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictNamespaces=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
