                CreateWordField (SBFB, \_SB.I2CD.TPAD._Y26._ADR, ADR0)  // _ADR: Address
                Method (_HID, 0, Serialized)  // _HID: Hardware ID
                {
                    If (~CondRefOf (TPDF))
                    {
