#!/bin/sh

NAME=gigabyte-laptop
VERSION=0.2.0

set -e

case "$1" in
    remove|upgrade|dconfigure)
        # The space before ] is required, and it was missing: `[ "$x"]` glues
        # the bracket to the argument, so `[` never sees its terminator and
        # exits with "missing ]". In an if-condition that reads as false, so
        # `dkms remove` was SKIPPED on every remove and upgrade, leaving the
        # registration behind. Inherited from upstream 4b817ea, not introduced
        # by the rename -- see the upstreaming list in CLAUDE.md.
        #
        # The guard is scoped to -v "$VERSION" so it asks the same question the
        # removal answers. `dkms status -m "$NAME"` alone is non-empty whenever
        # ANY version is registered, while the removal targets only $VERSION --
        # so with another version present and $VERSION absent, the guard passes
        # and `dkms remove` dies 3 ("The module/version combo ... is not located
        # in the DKMS tree", dkms 3.4.4 remove -> module_is_added_or_die). Under
        # `set -e` that aborts prerm, and dpkg fails the remove or upgrade.
        #
        # Unreachable before the fix above, which is why it arrives with it: the
        # broken test was always false, so `dkms remove` never ran at all.
        #
        # The status is captured separately because a FAILED query is not an
        # absent registration. `$(...)` inside a test discards the exit status,
        # so `dkms status` erroring while printing nothing looks exactly like it
        # succeeding and finding nothing -- and the latter means "skip", which
        # would leave the registration and the installed module behind while
        # dpkg reports the package removed. scripts/install-dkms.sh separates
        # the two for the same reason.
        #
        # It differs from that script in not aborting: a prerm that exits
        # non-zero blocks dpkg from removing the package at all, which is worse
        # than a stale registration. So this warns and carries on -- a reported
        # skip rather than a silent one.
        if ! registered=$(dkms status -m "$NAME" -v "$VERSION"); then
            echo "prerm: 'dkms status -m $NAME -v $VERSION' failed, so the DKMS" >&2
            echo "       registration could not be read and is left in place." >&2
            echo "       Inspect with: dkms status -m $NAME" >&2
        elif [ -n "$registered" ]; then
            dkms remove -m "$NAME" -v "$VERSION" --all
        fi
    ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0