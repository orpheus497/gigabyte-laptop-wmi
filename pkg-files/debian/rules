#!/usr/bin/make -f

MODULE = gigabyte-laptop
# Strip the Debian revision: every other packaging path (RPM, PKGBUILD,
# scripts/install-dkms.sh) registers the module as 0.2.0, and a DKMS tree
# called gigabyte-laptop-0.2.0-1 would not match any of them.
VERSION = $(shell dpkg-parsechangelog | sed -n 's/^Version: //p' | sed -e 's/-[^-]*$$//')
%:
	dh $@ --parallel --with dkms

override_dh_install:
	cp ../dkms.conf .
	sed -i dkms.conf -e "s/@PKGVER@/$(VERSION)/"
	dh_install dkms.conf ../Makefile ../README.md ../gigabyte-laptop.c usr/src/$(MODULE)-$(VERSION)/
	dh_install ../gigabyte-laptop.conf /etc/modules-load.d/
	rm dkms.conf

override_dh_dkms:
	dh_dkms -V $(VERSION)

override_dh_builddeb:
	dh_builddeb -- -Zxz