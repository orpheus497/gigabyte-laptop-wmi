# Maintainer: Albert Tang <tangalbert919@yahoo.com>

pkgbase=gigabyte-laptop
pkgname=gigabyte-laptop-dkms
pkgver=0.2.0
pkgrel=1
pkgdesc="Kernel module allowing more control on Gigabyte Aero/AORUS laptops"
arch=('x86_64')
url="https://www.github.com/tangalbert919/gigabyte-laptop-wmi"
license=('GPL2')
depends=('dkms')
replaces=('aorus-laptop-dkms')
conflicts=('aorus-laptop-dkms')
source=("${url}/releases/download/${pkgver//_/-}/driver.tar.gz")
sha256sums=("$(curl -sL ${url}/releases/download/${pkgver//_/-}/sum.txt | cut -d ' ' -f1)")

package() {
  # Set name and version
  sed -e "s/@PKGVER@/${pkgver//_/-}/" -i dkms.conf
  install -Dt "${pkgdir}/usr/src/${pkgbase}-${pkgver//_/-}" -m644 Makefile gigabyte-laptop.c dkms.conf

  # The module registers its platform device by hand and exposes no modalias,
  # so udev has nothing to match on and modules-load.d is the only thing that
  # brings it up at boot. Generated rather than taken from the release tarball,
  # which does not have to contain it.
  echo gigabyte_laptop | install -Dm644 /dev/stdin \
    "${pkgdir}/etc/modules-load.d/gigabyte-laptop.conf"
}